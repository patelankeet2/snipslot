# Copy this file to .env and fill in the real values. Never commit .env

NODE_ENV=development
PORT=4000

# Comma separated list of front end origins allowed by CORS
CLIENT_ORIGIN=http://localhost:5173

# MongoDB Atlas connection string (Atlas > Connect > Drivers)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/
MONGODB_DB=snipslot

# Long random string used to sign our own session tokens
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1d

# OAuth client id from Google Cloud (same value as the client app)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Google accounts that should get the owner role, comma separated
OWNER_EMAILS=owner@example.com

LOG_LEVEL=debug

# proxies in front of the API (2 in production: Vercel then Render)
TRUST_PROXY=1

# Web Push keys, generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Reminder job: run it in this process (true locally) and protect the HTTP trigger
ENABLE_CRON=true
CRON_SECRET=change-me-to-a-long-random-string

# AWS S3 for barber and service photos (IAM user limited to this bucket)
AWS_REGION=ap-southeast-2
S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
