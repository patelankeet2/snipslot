# Copy this file to .env and fill in the real values. Never commit .env

NODE_ENV=development
PORT=4000

# Comma separated list of front end origins allowed by CORS
CLIENT_ORIGIN=http://localhost:5173

# MongoDB Atlas connection string (Atlas > Connect > Drivers)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/
MONGODB_DB=snipslot

# Long random string used to sign our own session tokens
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1d

# OAuth client id from Google Cloud (same value as the client app)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Google accounts that should get the owner role, comma separated
OWNER_EMAILS=owner@example.com

LOG_LEVEL=debug
